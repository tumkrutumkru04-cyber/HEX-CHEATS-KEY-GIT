# ---------------------------------------------------------------
# HEX PROTOCOL — environment configuration
#
# NONE of these are required. The app auto-connects and
# self-provisions on first boot:
#   - DATABASE_URL: if missing, falls back to local SQLite (fine for
#     testing, but data won't persist on Railway - attach a Postgres
#     plugin for real use, Railway sets this automatically).
#   - SECRET_KEY / PAYLOAD_ENCRYPTION_KEY: if missing, generated once
#     and stored in the database, so they stay stable across restarts
#     without you setting anything.
#   - ADMIN_USERNAME / ADMIN_PASSWORD: if missing, a default account
#     is generated and printed ONCE to the deploy logs on first boot.
#
# Set any of these only if you want to control the value yourself.
# ---------------------------------------------------------------

ENV=production
DEBUG=false

# Railway's PostgreSQL plugin injects this automatically - no need to set by hand.
# DATABASE_URL=postgresql://user:password@host:5432/hexprotocol

# Optional - auto-generated and stored in the DB if left unset.
# SECRET_KEY=H26CWnmvyyKnhkiJfoNOF1CbAap03Cs_VbWdTdq3hfw
# PAYLOAD_ENCRYPTION_KEY=SNtz8NPrOSDg2tK83sAUqwolEBPz_Vcz9I25mU6CGYk

SESSION_MAX_AGE_SECONDS=28800
ENCRYPTION_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
DEFAULT_KEY_PREFIX=HEX

# Optional - if unset, check your Railway deploy logs after first boot
# for the auto-generated admin username/password.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
